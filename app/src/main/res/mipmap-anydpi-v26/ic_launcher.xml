<?xml version="1.0" encoding="utf-8"?>
<!--
  The artwork sits inside the central 72dp of the 108dp layer, so whatever
  shape a launcher masks with — circle, squircle, rounded square — the
  numbers along the top and the pencil at the right stay in frame. The
  background is the card's own teal, so the two layers meet invisibly.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
